{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bun scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "bun scripts/verify-site.mjs",
    "format": "prettier --write app components data lib styles scripts docs next.config.ts eslint.config.mjs README.md",
    "format:check": "prettier --check app components data lib styles scripts docs next.config.ts eslint.config.mjs README.md",
    "images:optimize": "bun scripts/optimize-images.mjs",
    "test": "bun test lib/webgl"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
